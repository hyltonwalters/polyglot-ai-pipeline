# Default local/demo mode. No external AI provider is called.
AI_MODE=mock

# Required only when AI_MODE=openai-compatible
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Go worker-pool configuration
MAX_WORKERS=4
JOB_TIMEOUT_MS=5000

# Optional service ports when running the Go worker directly
# PORT=8080

# FastAPI -> Go worker URL when running services directly instead of Docker Compose
# WORKER_URL=http://localhost:8080/v1/process-batch
